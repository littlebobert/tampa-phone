# LiveKit Cloud credentials (lk cloud auth can create .env.local for you)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Comma-separated E.164 numbers. Keep this set in both the app and LiveKit trunk.
ALLOWED_CALLER_NUMBERS=+18135550123
CALLER_NAME=Dad

# Twilio is only used for the safe cart-approval SMS handoff.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18135550124
ORDER_REVIEW_NUMBER=+18135550125

MENU_DATA_PATH=data/menus.json
AGENT_NAME=tampa-food-phone
